+// Unknown expiry and view-once content never enter the pilot payload store.
+func applySquireExpiry(evt *events.Message, leaf *waProto.Message, pm *ParsedMessage) {
+	ctx := contextInfoForMessage(leaf)
+	seconds := ctx.GetExpiration()
+	start := pm.Timestamp.Unix()
+	if hist := evt.SourceWebMsg; hist != nil {
+		if duration := hist.GetEphemeralDuration(); duration > 0 && (seconds == 0 || duration < seconds) {
+			seconds = duration
+		}
+		if stamp := hist.GetEphemeralStartTimestamp(); stamp > 0 {
+			evt.IsEphemeral = true
+			if start > 0 && stamp < uint64(start) {
+				start = int64(stamp)
+			}
+		}
+	}
+	pm.SquireExpiryKnown = leaf != nil && !evt.IsViewOnce && !evt.IsViewOnceV2 && !evt.IsViewOnceV2Extension &&
+		leaf.GetEphemeralMessage() == nil && leaf.GetViewOnceMessage() == nil &&
+		leaf.GetViewOnceMessageV2() == nil && leaf.GetViewOnceMessageV2Extension() == nil &&
+		(!evt.IsEphemeral || seconds > 0)
+	if seconds > 0 {
+		at := start + int64(seconds)
+		pm.SquireExpiresAt = &at
+		pm.SquireExpiryKnown = pm.SquireExpiryKnown && pm.Timestamp.Unix() > 0 && at <= 253402300799
+	}
+	if !pm.SquireExpiryKnown || (pm.SquireExpiresAt != nil && *pm.SquireExpiresAt <= time.Now().Unix()) {
+		*pm = ParsedMessage{Chat: pm.Chat, ID: pm.ID, SenderJID: pm.SenderJID, Timestamp: pm.Timestamp,
+			FromMe: pm.FromMe, SquireExpiryKnown: pm.SquireExpiryKnown, SquireExpiresAt: pm.SquireExpiresAt}
+	}
+}
