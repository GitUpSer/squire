# Explicit allowlist; build context is tenant-image/.
**
!Dockerfile
!.dockerignore
!supervisord.conf
!bin/
!bin/**
!home-template/
!home-template/**
!patches/
!patches/*.sh
!patches/*.patch
!patches/markers.tsv
!patches/compatibility.py
!overlay/
!overlay/overlay.yaml
!overlay/plugin/
!overlay/plugin/**
!overlay/managed/
!overlay/managed/**
!overlay/gate/
!overlay/gate/**
# Secrets and transient files remain excluded even inside an allowed directory.
**/.env
**/.env.*
**/*.pem
**/*.key
**/auth.json
**/__pycache__/**
**/*.py[cod]
**/*.log
**/*.egg-info/**
